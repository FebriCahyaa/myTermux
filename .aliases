#git
alias gitgraph="git log --all --decorate --oneline --graph"
alias gitupdate="git fetch && git pull"
alias gitstat="git status"
function gitad() { git add "$@"; }
function gitcom() {
  if (( $# == 0 )); then
    echo "Usage: gitcom COMMIT MESSAGE" >&2
    return 2
  fi
  local message="$*"
  git commit -m "$message"
}

