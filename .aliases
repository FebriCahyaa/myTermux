# MacPro Dark / Ubuntu proot helpers.
function mkcd() {
  if (( $# != 1 )); then echo "Usage: mkcd DIRECTORY" >&2; return 2; fi
  mkdir -p -- "$1" && cd -- "$1"
}
function extract() {
  if (( $# != 1 )); then echo "Usage: extract ARCHIVE" >&2; return 2; fi
  case "$1" in
    *.tar.bz2|*.tbz2) tar -xjf "$1" ;;
    *.tar.gz|*.tgz) tar -xzf "$1" ;;
    *.tar.xz|*.txz) tar -xJf "$1" ;;
    *.tar.zst) tar --zstd -xf "$1" ;;
    *.tar) tar -xf "$1" ;;
    *.zip) unzip "$1" ;;
    *.gz) gunzip "$1" ;;
    *.bz2) bunzip2 "$1" ;;
    *.xz) unxz "$1" ;;
    *) echo "Unsupported archive: $1" >&2; return 2 ;;
  esac
}
function croot() { git rev-parse --show-toplevel 2>/dev/null || pwd; }
function gst() { git status --short --branch; }
function gdiff() { git diff --color=always "$@"; }
function ub() { "$HOME/.local/bin/ubuntu" "$@"; }
function ubr() { "$HOME/.local/bin/ubroot" "$@"; }
function ubinstall() { "$HOME/.local/bin/ubuntu-install" "$@"; }
function mtdoctor() { "$HOME/.local/bin/mytermux-doctor" "$@"; }
