#!/usr/bin/env bash
# Explicit administrative shell in the PRoot userspace (not real Android root).
set -euo pipefail
[[ -n "${PREFIX:-}" ]] || { echo "Run this command from Termux." >&2; exit 1; }
PROFILE="${HOME}/.config/mytermux/ubuntu-profile.env"
[[ -r "$PROFILE" ]] || { echo "Missing $PROFILE. Run ./install.sh first." >&2; exit 1; }
# shellcheck source=/dev/null
source "$PROFILE"
DISTRO="${UBUNTU_DISTRO:-ubuntu}"
HOST_NAME="${UBUNTU_HOST:-ubuntu-dev}"
command -v proot-distro >/dev/null 2>&1 || { echo "Install proot-distro first: pkg install proot-distro" >&2; exit 1; }
if (($#)); then
  [[ "$1" == "--" ]] && shift
  exec proot-distro login --hostname "$HOST_NAME" --shared-tmp --bind "$HOME:/mnt/termux-home" "$DISTRO" -- "$@"
fi
exec proot-distro login --hostname "$HOST_NAME" --shared-tmp --bind "$HOME:/mnt/termux-home" "$DISTRO" -- /usr/bin/zsh -l
