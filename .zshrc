# myTermux — MacPro Dark Zsh configuration.
# Keep this file quick: do not run package updates or expensive scans on startup.

export ZSH="$HOME/.oh-my-zsh"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export TERM="${TERM:-xterm-256color}"

# Generated by install.sh. The prompt identity is cosmetic in native Termux;
# Android's actual application UID is managed by Android and is not changed.
[[ -r "$HOME/.config/mytermux/profile.env" ]] && source "$HOME/.config/mytermux/profile.env"
export MYTERMUX_ENV="termux"
export MYTERMUX_USER="${MYTERMUX_USER:-developer}"
export MYTERMUX_HOST="${MYTERMUX_HOST:-android-dev}"

[[ -n "${PREFIX:-}" ]] && export PATH="$PREFIX/bin:$PATH"
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"

ZSH_THEME="simple"
plugins=(
  git
  zsh-autosuggestions
  zsh-fzf-history-search
  zsh-autocomplete
)

if [[ -s "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
fi

# Syntax highlighting must be loaded after Oh My Zsh and other plugins.
[[ -r "$ZSH/custom/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] && \
  source "$ZSH/custom/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

[[ -r "$HOME/.config/lf/icons" ]] && source "$HOME/.config/lf/icons"
[[ -r "$HOME/.aliases" ]] && source "$HOME/.aliases"
[[ -r "$HOME/.autostart" ]] && source "$HOME/.autostart"

# Starship drives the user@host, directory, Git status, and two-line prompt.
if command -v starship >/dev/null 2>&1; then
  export STARSHIP_CONFIG="$XDG_CONFIG_HOME/starship.toml"
  eval "$(starship init zsh)"
else
  autoload -Uz colors && colors
  setopt PROMPT_SUBST
  PROMPT="%F{green}${MYTERMUX_USER}%f@%F{blue}${MYTERMUX_HOST}%f %F{magenta}%3~%f"$'\n'"%F{green}❯%f "
fi

# Completion settings used by zsh-autocomplete when it is installed.
zstyle ':autocomplete:*' min-delay 1.0
zstyle ':autocomplete:*' list-lines 5
zstyle ':completion:*:warnings' format ''
